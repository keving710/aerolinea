# Copia estos valores como variables de entorno (en Vercel: Settings > Environment Variables).
# En local no hace falta nada: sin DATABASE_URL se usa SQLite.

# Obligatoria en producción. Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=cambia-esto

# 0 en producción. En local puedes usar DEBUG=1.
DEBUG=0

# PostgreSQL externo (Neon o Supabase). Usa la cadena "pooled" para la app en Vercel.
DATABASE_URL=postgresql://usuario:clave@host/basedatos?sslmode=require

# Cloudinary para las fotos de perfil (Vercel no guarda archivos). Opcional en local.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Credenciales del root creado por defecto al ejecutar `migrate` (HU 4).
ROOT_USERNAME=root
ROOT_PASSWORD=Root2026!

# Opcionales: dominios propios (separados por coma).
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
